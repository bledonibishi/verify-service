generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  NEEDS_REVIEW
  EXPIRED
}

enum DocumentKind {
  ID_FRONT
  ID_BACK
  SELFIE
  // Driving licence: the front is read (printed fields), the back is stored for reviewers only
  LICENCE_FRONT
  LICENCE_BACK
}

model Tenant {
  id            String    @id @default(uuid())
  name          String
  apiKeyHash    String    @unique @map("api_key_hash")
  webhookUrl    String?   @map("webhook_url")
  webhookSecret String    @map("webhook_secret")
  // When true, a submission whose automated checks all pass cleanly is approved without a
  // reviewer. Off by default: every submission then goes to manual review.
  autoApprove   Boolean   @default(false) @map("auto_approve")
  // Minimum selfie-to-ID similarity (0-100) that counts as a face match
  faceMatchThreshold Float @default(90) @map("face_match_threshold")
  // Minimum liveness confidence (0-100) that counts as a live person
  livenessMinConfidence Float @default(90) @map("liveness_min_confidence")
  createdAt     DateTime  @default(now()) @map("created_at")
  sessions      Session[]
  reviewers     Reviewer[]
  webhookEvents WebhookEvent[]
  usageEvents   UsageEvent[]
  // Cost protection: once this many verifications are billable or in flight in a UTC month,
  // creating another session answers 429. Null means no cap.
  monthlyVerificationCap Int? @map("monthly_verification_cap")
  // A warning is logged (once a month) when usage reaches this percent of the cap
  softLimitPercent       Int  @default(80) @map("soft_limit_percent")
  softLimitNotifiedMonth String? @map("soft_limit_notified_month")
  // Documents (images) are deleted this many days after the final decision. 0 = right away.
  documentRetentionDays Int @default(30) @map("document_retention_days")
  // The whole session record (results, audit log, expected identity) is deleted this many days
  // after the decision. The default matches the 5-year minimum some regulated customers need.
  recordRetentionDays   Int @default(1825) @map("record_retention_days")
  // Regulated tenants may export evidence (including the decrypted documents) through the API
  evidenceExport        Boolean @default(false) @map("evidence_export")

  @@map("tenants")
}

model Session {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  // Caller's own identifier for the user being verified
  externalRef String        @map("external_ref")
  // SHA-256 of the one-time upload token embedded in the session URL
  tokenHash   String        @unique @map("token_hash")
  status      SessionStatus @default(PENDING)
  expectedFirstName String? @map("expected_first_name")
  expectedLastName  String? @map("expected_last_name")
  expectedBirthDate String? @map("expected_birth_date")
  // Set when the user starts a liveness challenge; the result is read by the pipeline
  livenessSessionId String? @map("liveness_session_id")
  // When true the user must also upload a driving licence, which is read and cross-checked with the ID
  requireLicence Boolean @default(false) @map("require_licence")
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  documents   Document[]
  auditLogs   AuditLog[]
  job         VerificationJob?
  webhookEvents WebhookEvent[]
  result      VerificationResult?
  // Set when a reviewer decides a NEEDS_REVIEW session
  reviewedById   String?   @map("reviewed_by_id")
  reviewedBy     Reviewer? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewReason   String?   @map("review_reason")
  reviewedAt     DateTime? @map("reviewed_at")
  // When the session reached APPROVED or REJECTED; retention clocks start here
  decidedAt      DateTime? @map("decided_at")
  documentsDeletedAt DateTime? @map("documents_deleted_at")
  // What the deleted documents were: [{ kind, contentType, sizeBytes, sha256 }]
  documentsManifest  Json? @map("documents_manifest")

  @@index([tenantId, externalRef])
  @@index([tenantId, status, createdAt])
  @@map("sessions")
}

model Document {
  id          String       @id @default(uuid())
  sessionId   String       @map("session_id")
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        DocumentKind
  storageKey  String       @map("storage_key")
  contentType String       @map("content_type")
  sizeBytes   Int          @map("size_bytes")
  // SHA-256 of the stored image bytes, for evidence integrity (null on older rows)
  sha256      String?
  createdAt   DateTime     @default(now()) @map("created_at")

  @@unique([sessionId, kind])
  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event     String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("audit_logs")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
}

// Postgres-backed work queue: one job per submitted session. Workers claim rows with
// FOR UPDATE SKIP LOCKED; a RUNNING job whose lease has lapsed is picked up again.
model VerificationJob {
  id          String    @id @default(uuid())
  sessionId   String    @unique @map("session_id")
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  runAfter    DateTime  @default(now()) @map("run_after")
  lockedUntil DateTime? @map("locked_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@map("verification_jobs")
}

// Outcome of the automated checks. Holds pass/fail flags and issue codes only: no names, dates,
// document numbers or personal numbers read from the document.
model VerificationResult {
  id              String   @id @default(uuid())
  sessionId       String   @unique @map("session_id")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Status the pipeline moved the session to (APPROVED or NEEDS_REVIEW)
  decision        String
  autoDecided     Boolean  @map("auto_decided")
  mrzFound        Boolean  @map("mrz_found")
  mrzValid        Boolean  @map("mrz_valid")
  ocrRepaired     Boolean  @map("ocr_repaired")
  // match | mismatch | not_provided; null when the MRZ could not be read
  surnameMatch    String?  @map("surname_match")
  givenNamesMatch String?  @map("given_names_match")
  birthDateMatch  String?  @map("birth_date_match")
  expired         Boolean?
  // [{ field, ok }] for each MRZ check digit
  checks          Json
  issueCodes      String[] @map("issue_codes")
  ocrProvider     String   @map("ocr_provider")
  // match | below_threshold | no_face | unusable_image; null when the check did not run
  faceStatus      String?  @map("face_status")
  faceSimilarity  Float?   @map("face_similarity")
  faceProvider    String?  @map("face_provider")
  // liveness | selfie: which image the face comparison used
  faceSource      String?  @map("face_source")
  // live | not_live | incomplete; null when no liveness check ran
  livenessStatus     String? @map("liveness_status")
  livenessConfidence Float?  @map("liveness_confidence")
  livenessProvider   String? @map("liveness_provider")
  // Driving licence checks; null when the session did not ask for a licence. Flags and field NAMES
  // only: no value printed on the licence is stored.
  licenceFound            Boolean?  @map("licence_found")
  licenceFields           String[]  @default([]) @map("licence_fields")
  licenceExpired          Boolean?  @map("licence_expired")
  licenceDatesValid       Boolean?  @map("licence_dates_valid")
  licenceRepaired         Boolean?  @map("licence_repaired")
  // match | mismatch | unavailable (the ID could not be read, so there was nothing to compare with)
  licencePersonalNumberMatch String? @map("licence_personal_number_match")
  licenceSurnameMatch     String?   @map("licence_surname_match")
  licenceGivenNamesMatch  String?   @map("licence_given_names_match")
  licenceBirthDateMatch   String?   @map("licence_birth_date_match")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("verification_results")
}

// A person on the tenant's own staff who reviews sessions. Scoped to one tenant.
model Reviewer {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String            @unique
  name           String?
  // scrypt$N$r$p$salt$hash (base64); see src/review/password.ts
  passwordHash   String            @map("password_hash")
  disabled       Boolean           @default(false)
  failedLogins   Int               @default(0) @map("failed_logins")
  lockedUntil    DateTime?         @map("locked_until")
  createdAt      DateTime          @default(now()) @map("created_at")
  sessions       ReviewerSession[]
  decisions      Session[]

  @@index([tenantId])
  @@map("reviewers")
}

// Browser login for a reviewer. The cookie holds a random token; only its hash is stored.
model ReviewerSession {
  id         String   @id @default(uuid())
  reviewerId String   @map("reviewer_id")
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([reviewerId])
  @@map("reviewer_sessions")
}

// Proof that a session was erased. Deliberately holds no personal data: not even the tenant's
// own reference for the person, only the session id the tenant already has.
model DeletionRecord {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  sessionId     String   @map("session_id")
  // retention | abandoned | tenant_request
  reason        String
  documentCount Int      @map("document_count")
  deletedAt     DateTime @default(now()) @map("deleted_at")

  @@index([tenantId, deletedAt])
  @@map("deletion_records")
}

enum WebhookEventStatus {
  PENDING
  DELIVERED
  FAILED
}

// Outbox: written in the same transaction as the status change it announces, delivered by a
// worker with retries. The body is stored exactly as sent so every attempt is byte-identical.
model WebhookEvent {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Erasing a session erases its pending and past events
  sessionId     String             @map("session_id")
  session       Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type          String
  body          String
  status        WebhookEventStatus @default(PENDING)
  attempts      Int                @default(0)
  // Bumped on every claim and never reset (a replay resets `attempts`): it fences outcomes so a
  // stale in-flight delivery can never match a later claim of the same event
  claims        Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @map("next_attempt_at")
  lockedUntil   DateTime?          @map("locked_until")
  // http_<status> | timeout | network | redirect | no_url: a fixed code, never the response body
  lastError     String?            @map("last_error")
  deliveredAt   DateTime?          @map("delivered_at")
  // When it last entered FAILED; failed-event retention counts from here, not from creation
  failedAt      DateTime?          @map("failed_at")
  createdAt     DateTime           @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([tenantId, createdAt])
  @@map("webhook_events")
}

// One row per completed verification (kind "verification"), or an operator correction (kind
// "adjustment", negative quantity for a credit). Written in the same transaction as the decision.
// Holds ids, times and booleans only. session_id is deliberately not a foreign key: erasing a
// person (retention or a data-subject request) must not erase the invoice trail.
model UsageEvent {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  // verification | adjustment
  kind              String   @default("verification")
  // Null for adjustments. Unique per kind, so a session is counted once however often it is processed.
  sessionId         String?  @map("session_id")
  occurredAt        DateTime @map("occurred_at")
  quantity          Int      @default(1)
  billable          Boolean  @default(true)
  // pipeline_error | ocr_unavailable: our failures, recorded but not billed
  nonBillableReason String?  @map("non_billable_reason")
  face              Boolean  @default(false)
  liveness          Boolean  @default(false)
  licence           Boolean  @default(false)
  autoDecided       Boolean  @default(false) @map("auto_decided")
  // Operator note on an adjustment (never personal data)
  note              String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([sessionId, kind])
  @@index([tenantId, occurredAt])
  @@map("usage_events")
}
