generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SessionStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  NEEDS_REVIEW
  EXPIRED
}

enum DocumentKind {
  ID_FRONT
  ID_BACK
  SELFIE
}

model Tenant {
  id            String    @id @default(uuid())
  name          String
  apiKeyHash    String    @unique @map("api_key_hash")
  webhookUrl    String?   @map("webhook_url")
  webhookSecret String    @map("webhook_secret")
  // When true, a submission whose automated checks all pass cleanly is approved without a
  // reviewer. Off by default: every submission then goes to manual review.
  autoApprove   Boolean   @default(false) @map("auto_approve")
  // Minimum selfie-to-ID similarity (0-100) that counts as a face match
  faceMatchThreshold Float @default(90) @map("face_match_threshold")
  // Minimum liveness confidence (0-100) that counts as a live person
  livenessMinConfidence Float @default(90) @map("liveness_min_confidence")
  createdAt     DateTime  @default(now()) @map("created_at")
  sessions      Session[]
  reviewers     Reviewer[]

  @@map("tenants")
}

model Session {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  // Caller's own identifier for the user being verified
  externalRef String        @map("external_ref")
  // SHA-256 of the one-time upload token embedded in the session URL
  tokenHash   String        @unique @map("token_hash")
  status      SessionStatus @default(PENDING)
  expectedFirstName String? @map("expected_first_name")
  expectedLastName  String? @map("expected_last_name")
  expectedBirthDate String? @map("expected_birth_date")
  // Set when the user starts a liveness challenge; the result is read by the pipeline
  livenessSessionId String? @map("liveness_session_id")
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  documents   Document[]
  auditLogs   AuditLog[]
  job         VerificationJob?
  result      VerificationResult?
  // Set when a reviewer decides a NEEDS_REVIEW session
  reviewedById   String?   @map("reviewed_by_id")
  reviewedBy     Reviewer? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewReason   String?   @map("review_reason")
  reviewedAt     DateTime? @map("reviewed_at")

  @@index([tenantId, externalRef])
  @@index([tenantId, status, createdAt])
  @@map("sessions")
}

model Document {
  id          String       @id @default(uuid())
  sessionId   String       @map("session_id")
  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        DocumentKind
  storageKey  String       @map("storage_key")
  contentType String       @map("content_type")
  sizeBytes   Int          @map("size_bytes")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@unique([sessionId, kind])
  @@map("documents")
}

model AuditLog {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event     String
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("audit_logs")
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
}

// Postgres-backed work queue: one job per submitted session. Workers claim rows with
// FOR UPDATE SKIP LOCKED; a RUNNING job whose lease has lapsed is picked up again.
model VerificationJob {
  id          String    @id @default(uuid())
  sessionId   String    @unique @map("session_id")
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  runAfter    DateTime  @default(now()) @map("run_after")
  lockedUntil DateTime? @map("locked_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAfter])
  @@map("verification_jobs")
}

// Outcome of the automated checks. Holds pass/fail flags and issue codes only: no names, dates,
// document numbers or personal numbers read from the document.
model VerificationResult {
  id              String   @id @default(uuid())
  sessionId       String   @unique @map("session_id")
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // Status the pipeline moved the session to (APPROVED or NEEDS_REVIEW)
  decision        String
  autoDecided     Boolean  @map("auto_decided")
  mrzFound        Boolean  @map("mrz_found")
  mrzValid        Boolean  @map("mrz_valid")
  ocrRepaired     Boolean  @map("ocr_repaired")
  // match | mismatch | not_provided; null when the MRZ could not be read
  surnameMatch    String?  @map("surname_match")
  givenNamesMatch String?  @map("given_names_match")
  birthDateMatch  String?  @map("birth_date_match")
  expired         Boolean?
  // [{ field, ok }] for each MRZ check digit
  checks          Json
  issueCodes      String[] @map("issue_codes")
  ocrProvider     String   @map("ocr_provider")
  // match | below_threshold | no_face | unusable_image; null when the check did not run
  faceStatus      String?  @map("face_status")
  faceSimilarity  Float?   @map("face_similarity")
  faceProvider    String?  @map("face_provider")
  // liveness | selfie: which image the face comparison used
  faceSource      String?  @map("face_source")
  // live | not_live | incomplete; null when no liveness check ran
  livenessStatus     String? @map("liveness_status")
  livenessConfidence Float?  @map("liveness_confidence")
  livenessProvider   String? @map("liveness_provider")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("verification_results")
}

// A person on the tenant's own staff who reviews sessions. Scoped to one tenant.
model Reviewer {
  id             String            @id @default(uuid())
  tenantId       String            @map("tenant_id")
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email          String            @unique
  name           String?
  // scrypt$N$r$p$salt$hash (base64); see src/review/password.ts
  passwordHash   String            @map("password_hash")
  disabled       Boolean           @default(false)
  failedLogins   Int               @default(0) @map("failed_logins")
  lockedUntil    DateTime?         @map("locked_until")
  createdAt      DateTime          @default(now()) @map("created_at")
  sessions       ReviewerSession[]
  decisions      Session[]

  @@index([tenantId])
  @@map("reviewers")
}

// Browser login for a reviewer. The cookie holds a random token; only its hash is stored.
model ReviewerSession {
  id         String   @id @default(uuid())
  reviewerId String   @map("reviewer_id")
  reviewer   Reviewer @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([reviewerId])
  @@map("reviewer_sessions")
}
