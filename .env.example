PORT=4100
DATABASE_URL=postgresql://verify:verify@localhost:5434/verify

# Public base URL used to build the session URLs handed to end users
PUBLIC_BASE_URL=http://localhost:4100

# 32-byte key, base64 (generate: openssl rand -base64 32). Encrypts stored documents.
STORAGE_ENCRYPTION_KEY=

# Where documents live: "local" (disk, single host, development) or "s3" (see docs/storage.md)
# STORAGE_DRIVER=local
# Where encrypted documents are written (local adapter)
STORAGE_LOCAL_DIR=./storage


# How long a session link stays valid, in minutes
SESSION_TTL_MINUTES=60

# OCR engine for reading the MRZ on the ID back. Only "tesseract" (self-hosted CLI) exists today.
OCR_PROVIDER=tesseract
# TESSERACT_BIN=tesseract
# eng works; install the ocrb traineddata and set ocrb for better MRZ accuracy
# TESSERACT_LANG=eng

# Background verification worker
# VERIFICATION_WORKER_ENABLED=true
# VERIFICATION_POLL_MS=2000
# Jobs processed in parallel per instance (default 2)
# VERIFICATION_CONCURRENCY=2
# VERIFICATION_RETRY_BASE_MS=5000
# Requests per minute per IP (default 60)
# THROTTLE_LIMIT=60

# Face match (ID portrait vs selfie). "none" (default) sends no images anywhere and leaves every
# session in manual review. "rekognition" sends both images to AWS Rekognition in AWS_REGION.
# Credentials come from the AWS SDK default chain (env vars locally, an IAM role in production).
# Never put real keys in this file.
# FACE_PROVIDER=rekognition
# AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Liveness (is the selfie a live person?). "none" is the only value for now; the AWS Face Liveness
# adapter and browser widget come with the hosted upload page. Until then nothing is auto-approved,
# because auto-approval requires a passed liveness check.
# LIVENESS_PROVIDER=none

# Review UI login attempts per minute per IP (default 10)
# LOGIN_RATE_LIMIT=10

# Retention job (deletes documents and records per tenant settings; see docs/retention.md)
# RETENTION_JOB_ENABLED=true
# RETENTION_INTERVAL_MS=3600000
# Unsubmitted sessions are erased this many hours after their link expires
# ABANDONED_GRACE_HOURS=24
# Sessions handled per batch by the retention job (default 50)
# RETENTION_BATCH=50

# S3 storage (STORAGE_DRIVER=s3). Put real values in .env only, never in this file.
# S3_BUCKET=<the full bucket name>
# S3_REGION=eu-central-1
# Dedicated keys for storage; omit both to use the AWS default chain (an IAM role in production)
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# AES256 (default), aws:kms (needs S3_KMS_KEY_ID) or none (S3-compatible servers without it)
# S3_SSE=AES256
# S3_KMS_KEY_ID=
# Optional folder inside the bucket, and settings for S3-compatible servers (tests use http://localhost:9100)
# S3_KEY_PREFIX=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false


# Webhook delivery (outbox with retries; see README)
# WEBHOOK_DISPATCHER_ENABLED=true
# WEBHOOK_POLL_MS=2000
# WEBHOOK_CONCURRENCY=4
# Attempts before an event is marked FAILED (default 9; waits grow from 30 s up to 24 h)
# WEBHOOK_MAX_ATTEMPTS=9
# Base of the retry schedule in ms (default 30000)
# WEBHOOK_RETRY_BASE_MS=30000
# Per-request timeout in ms (default 10000)
# WEBHOOK_TIMEOUT_MS=10000
# Delivered events are deleted after this many days, failed ones after the second value
# WEBHOOK_EVENT_RETENTION_DAYS=7
# WEBHOOK_FAILED_RETENTION_DAYS=30
